@model UsedCar
@{
    ViewData["Title"] = "AutoGems.Ai - Find the cheapest and most reliable used cars near you!";
}
<div class="">

    <!-- Hero -->
    <div class="car-Background relative flex w-full items-center justify-center overflow-hidden bg-gray-50 bg-gray-200 pt-32">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-xs"></div>


        <div class="z-10 container mx-auto grid items-center gap-12 px-4 py-16 md:px-10 md:py-32 lg:grid-cols-2 lg:px-32 xl:max-w-6xl">


            <!-- LEFT SIDE (Form) -->
            <div id="bottomSection" class="order-2 rounded-2xl bg-[#EAE0D5] px-10 py-14 shadow-xl lg:order-1">
                <h1 class="text-4xl font-extrabold text-[#0A0908]">
                    Find Your Car!
                </h1>

                <p class="mt-6 leading-relaxed text-[#5E503F]">
                    <span class="font-semibold text-[#22333B]">You want the best!</span>
                    We want that for you as well. No more guessing whether that car is right for you.
                    Let us help you find the perfect used and reliable car within your budget.
                    Listed below are the most reliable used cars according to Consumer Report and Dave Ramsey.
                </p>
                <div class="flex">
                    <a href="https://www.consumerreports.org/cars/best-used-cars-10-top-picks-a8027733372/#used-car-top-picks-under-10000" target="_blank">
                        <img src="~/images/ConsumerReportLogo.png" alt="Consumer Reports Logo" class="mt-4 h-12 cursor-pointer" />
                    </a>
                    <a href="https://www.ramseysolutions.com/insurance/new-car-vs-used-car" target="_blank">
                        <img src="~/images/RamseyLogo.jpg" alt="Dave Ramsey Logo" class="mt-4 h-12 cursor-pointer" />
                    </a>
                </div>

                <form method="get" asp-action="FindCars" asp-controller="Home" class="mt-10 space-y-5">
                    @{
                        var grouped = Model.UsedCars
                        .GroupBy(c => c.PriceCategory)
                        .OrderBy(g => g.Key);
                    }

                    @foreach (var group in grouped)
                    {
                        var id = $"group_{group.Key}";
                        <div class="mb-6 overflow-hidden rounded-lg border">

                            <!-- Accordion Header -->
                            <button type="button"
                                    class="flex w-full items-center justify-between bg-[#22333B]/10 px-4 py-3 transition hover:bg-[#22333B]/20"
                                    onclick="toggleAccordion('@id')">

                                <span class="text-lg font-semibold text-[#22333B]">
                                    Under $@group.Key.ToString("N0")
                                </span>

                                <svg id="@(id)_icon"
                                     class="h-5 w-5 text-[#5E503F] transition-transform duration-300"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>

                            <!-- Accordion Content -->
                            <div id="@id" class="max-h-0 overflow-hidden bg-[#EAE0D5] transition-all duration-300">
                                <div class="space-y-3 p-4">
                                    @foreach (var car in group)
                                    {
                                        var value = $"{car.Make}|{car.Model}|{car.Year}|{car.PriceCategory}";
                                        <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-[#C6AC8F] p-3 hover:bg-[#C6AC8F]/20">
                                            <input type="radio"
                                                   name="selectedCar"
                                                   value="@value"
                                                   class="h-4 w-4 border-[#C6AC8F] focus:ring-2 focus:ring-[#C6AC8F]" />

                                            <span class="text-sm font-medium text-[#22333B]">
                                                @car.Make @car.Model (@car.Year)
                                            </span>
                                        </label>
                                    }
                                </div>
                            </div>

                        </div>
                    }

                    <div class="space-y-4 rounded-lg border border-[#C6AC8F] bg-[#f5ede3]/60 p-4">
                        <p class="text-sm font-semibold text-[#22333B]">Where should we look?</p>
                        <label class="flex cursor-pointer items-start gap-3 text-sm text-[#22333B]">
                            <input type="checkbox" name="nationwide" value="true"
                                   class="mt-1 h-4 w-4 shrink-0 rounded border-[#C6AC8F] text-[#5E503F] focus:ring-[#C6AC8F]" />
                            <span>Search the <span class="font-semibold">entire United States</span> (ignores city, state, and ZIP)</span>
                        </label>
                        <div class="grid gap-3 sm:grid-cols-2">
                            <div>
                                <label for="searchCity" class="mb-1 block text-xs font-medium text-[#5E503F]">City</label>
                                <input id="searchCity" type="text" name="city" maxlength="80"
                                       class="w-full rounded-lg border border-[#C6AC8F] bg-[#EAE0D5] px-3 py-2 text-sm text-[#22333B] placeholder:text-[#5E503F]/60 focus:border-[#5E503F] focus:outline-none"
                                       placeholder="e.g. Austin" autocomplete="address-level2" />
                            </div>
                            <div>
                                <label for="searchState" class="mb-1 block text-xs font-medium text-[#5E503F]">State</label>
                                <select id="searchState" name="state"
                                        class="w-full rounded-lg border border-[#C6AC8F] bg-[#EAE0D5] px-3 py-2 text-sm text-[#22333B] focus:border-[#5E503F] focus:outline-none">
                                    <option value="">— Select —</option>
                                    @foreach (var st in UsedAndReliableCars.Models.UsStates.All)
                                    {
                                        <option value="@st.Code">@st.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div>
                            <label for="searchZip" class="mb-1 block text-xs font-medium text-[#5E503F]">ZIP code (optional)</label>
                            <input id="searchZip" type="text" name="zip" inputmode="numeric" maxlength="10"
                                   class="w-full max-w-xs rounded-lg border border-[#C6AC8F] bg-[#EAE0D5] px-3 py-2 text-sm text-[#22333B] placeholder:text-[#5E503F]/60 focus:border-[#5E503F] focus:outline-none"
                                   placeholder="If set, used instead of city/state" autocomplete="postal-code" />
                        </div>
                        <p class="text-xs leading-relaxed text-[#5E503F]">
                            Leave city/state empty and leave &quot;entire US&quot; unchecked to search nationwide with no location filter.
                            If you enter a ZIP, it takes priority over city and state.
                        </p>
                    </div>

                    <button type="submit"
                            class="w-full rounded-lg bg-[var(--tan)] py-3 font-semibold text-[var(--jet)] transition hover:bg-[var(--brown)] hover:text-[var(--bone)] hover:shadow-md">
                        Find these cars
                    </button>
                </form>
            </div>
            <!-- RIGHT SIDE (Heading + Buttons) -->
            <div class="order-1 text-center lg:order-2 lg:text-left">
                <h1 class="text-4xl leading-tight font-extrabold text-white drop-shadow-lg sm:text-5xl">
                    AutoGems.Ai
                </h1>

                <p class="mt-8 mb-12 text-lg text-gray-100 drop-shadow-md">
                    Find used and reliable cars near you!
                </p>

                <div class="flex flex-wrap justify-center gap-4 lg:justify-start">
                    <a href="#bottomSection"
                       class="inline-block rounded bg-[var(--tan)] px-8 py-3 text-center text-lg
                       font-semibold text-[var(--jet)] transition-transform hover:scale-105 hover:bg-[var(--brown)] hover:text-[var(--bone)] hover:shadow-[0_10px_20px_-10px_black]">
                        Find My Next Car!
                    </a>

                    <a href="#"
                       class="rounded border border-[#EAE0D5] px-8 py-3 text-lg text-[#EAE0D5]
                      transition-colors hover:bg-[#EAE0D5] hover:text-[#22333B]">
                        About our Service
                    </a>
                </div>
            </div>


        </div>


        <div class="pointer-events-none absolute bottom-0 left-0 h-32 w-full bg-gradient-to-b from-transparent to-[#EAE0D5]"></div>

    </div>


    <!-- Feature Strip -->
    <section class="w-full bg-[#EAE0D5] px-8 py-16">
        <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 text-center md:grid-cols-3">
            <div>
                <h3 class="mb-2 text-2xl font-bold text-[#22333B]">Fast</h3>
                <p class="text-[#5E503F]">Find hundreds of used cars at the click of a button</p>
            </div>
            <div>
                <h3 class="mb-2 text-2xl font-bold text-[#22333B]">Accurate</h3>
                <p class="text-[#5E503F]">Find exactly what you're searching for</p>
            </div>
            <div>
                <h3 class="mb-2 text-2xl font-bold text-[#22333B]">Only The Best</h3>
                <p class="text-[#5E503F]">We do our research so that you will only find the best used cars</p>
            </div>
        </div>
    </section>

@* ai section *@
    <section class="line-bg relative flex min-h-screen w-screen justify-center px-8 py-16">

        <!-- Top fade (into previous section) -->
        <div class="pointer-events-none absolute top-0 left-0 h-32
                w-full bg-gradient-to-t from-transparent
                to-[#EAE0D5]"></div>

        <!-- Bottom fade (into next section) -->
        <div class="pointer-events-none absolute bottom-0 left-0 h-32
                w-full bg-gradient-to-b from-transparent
                to-[#EAE0D5]"></div>

        <div class="max-w-8xl mx-auto gap-10 text-center transition">
            <div>
                <h3 class="mb-2 text-2xl font-bold text-white">AI Integration</h3>
                <p class="text-gray-200">Ask our AI for help finding a car that fits your budget and reliability needs.</p>

                <div id="askAiButton"
                     class="outer-cont flex transform cursor-pointer items-center gap-2 duration-500">

                    <!-- SVG unchanged -->
                    <svg viewBox="0 0 24 24" height="24" width="24" xmlns="http://www.w3.org/2000/svg">
                        <g fill="none">
                            <path d="m12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.003-.011l.018-.43l-.003-.012l-.01-.01z"></path>
                            <path d="M9.107 5.448c.598-1.75 3.016-1.803 3.725-.159l.06.16l.807 2.36a4 4 0 0 0 2.276 2.411l.217.081l2.36.806c1.75.598 1.803 3.016.16 3.725l-.16.06l-2.36.807a4 4 0 0 0-2.412 2.276l-.081.216l-.806 2.361c-.598 1.75-3.016 1.803-3.724.16l-.062-.16l-.806-2.36a4 4 0 0 0-2.276-2.412l-.216-.081l-2.36-.806c-1.751-.598-1.804-3.016-.16-3.724l.16-.062l2.36-.806A4 4 0 0 0 8.22 8.025l.081-.216zM11 6.094l-.806 2.36a6 6 0 0 1-3.49 3.649l-.25.091l-2.36.806l2.36.806a6 6 0 0 1 3.649 3.49l.091.25l.806 2.36l.806-2.36a6 6 0 0 1 3.49-3.649l.25-.09l2.36-.807l-2.36-.806a6 6 0 0 1-3.649-3.49l-.09-.25zM19 2a1 1 0 0 1 .898.56l.048.117l.35 1.026l1.027.35a1 1 0 0 1 .118 1.845l-.118.048l-1.026.35l-.35 1.027a1 1 0 0 1-1.845.117l-.048-.117l-.35-1.026l-1.027-.35a1 1 0 0 1-.118-1.845l.118-.048l1.026-.35l.35-1.027A1 1 0 0 1 19 2"
                                  fill="currentColor"></path>
                        </g>
                    </svg>
                    Ask Our AI for Help
                </div>
            </div>
        </div>

        <div id="aiChatbox"
             class="ai-chatbox-outer mx-auto mt-10 hidden w-full max-w-6xl translate-y-4 px-2 opacity-0 transition-all duration-500 sm:px-4">
            <div class="ai-chat-shell">
                <aside id="aiRecommendations"
                       class="ai-listing-panel hidden max-h-[min(70vh,520px)] flex-col overflow-hidden rounded-xl border border-[#C6AC8F] bg-[#EAE0D5] shadow-lg">
                    <div class="ai-listing-panel-header border-b border-[#C6AC8F] bg-[#22333B] px-4 py-3 text-left text-sm font-semibold text-[#EAE0D5]">
                        Recommended listings
                    </div>
                    <div id="aiListingCards" class="ai-listing-cards flex flex-1 flex-col gap-2 overflow-y-auto p-3"></div>
                </aside>
                <div class="card ai-chat-card">
                    <div class="chat-header">Chat</div>
                    <div class="chat-window">
                        <ul class="message-list"></ul>
                    </div>
                    <div class="chat-input">
                        <input type="text" class="message-input" placeholder="Type your message here">
                        <button class="send-button">Send</button>
                    </div>
                </div>
            </div>
        </div>



    </section>

@* Search Section — kept for reference
    <section id="bottomSection" class="bg-gray-50 py-20">
        ...
    </section>
*@

</div>

<script>
    const btn = document.getElementById("askAiButton");
    const box = document.getElementById("aiChatbox");
    const chatUrl = "@Url.Action("Chat", "Home")";
    const messageList = box.querySelector(".message-list");
    const messageInput = box.querySelector(".message-input");
    const sendButton = box.querySelector(".send-button");
    const transcript = [];

    btn.addEventListener("click", () => {
        btn.classList.add("hidden");
        box.classList.remove("hidden");
        requestAnimationFrame(() => {
            box.classList.remove("opacity-0", "translate-y-4");
            box.classList.add("opacity-100", "translate-y-0");
        });
    });

    function renderListingCards(listings) {
        const panel = document.getElementById("aiRecommendations");
        const listEl = document.getElementById("aiListingCards");
        if (!panel || !listEl) return;
        listEl.innerHTML = "";
        if (!listings || listings.length === 0) {
            panel.classList.add("hidden");
            panel.classList.remove("flex");
            return;
        }
        panel.classList.remove("hidden");
        panel.classList.add("flex");
        for (const car of listings) {
            const url = car.vdpUrl;
            if (!url) continue;
            const a = document.createElement("a");
            a.href = url;
            a.target = "_blank";
            a.rel = "noopener noreferrer";
            a.className = "ai-listing-card";
            if (car.pickRank != null && car.pickRank <= 8) {
                const badge = document.createElement("div");
                badge.className = "ai-listing-pick-badge";
                badge.textContent = "#" + car.pickRank + (car.pickRank <= 3 ? " pick" : "");
                a.appendChild(badge);
            }
            const title = document.createElement("div");
            title.className = "ai-listing-card-title";
            title.textContent = car.heading || "Vehicle";
            a.appendChild(title);
            const meta = document.createElement("div");
            meta.className = "ai-listing-card-meta";
            const parts = [];
            if (car.price != null) parts.push("$" + Number(car.price).toLocaleString());
            if (car.miles != null) parts.push(Number(car.miles).toLocaleString() + " mi");
            const loc = [car.city, car.state].filter(Boolean).join(", ");
            if (loc) parts.push(loc);
            meta.textContent = parts.join(" · ");
            a.appendChild(meta);
            listEl.appendChild(a);
        }
    }

    function appendChatLine(role, text, isError) {
        const li = document.createElement("li");
        li.className = isError ? "message-error" : (role === "user" ? "message-user" : "message-assistant");
        const span = document.createElement("span");
        span.textContent = text;
        li.appendChild(span);
        messageList.appendChild(li);
        const win = box.querySelector(".chat-window");
        win.scrollTop = win.scrollHeight;
    }

    async function sendChatMessage() {
        const text = (messageInput.value || "").trim();
        if (!text) return;

        messageInput.value = "";
        transcript.push({ role: "user", text });
        appendChatLine("user", text, false);

        sendButton.disabled = true;
        messageInput.disabled = true;

        try {
            const res = await fetch(chatUrl, {
                method: "POST",
                headers: { "Content-Type": "application/json", "Accept": "application/json" },
                body: JSON.stringify({ messages: transcript })
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) {
                const err = data.error || res.statusText || "Request failed";
                appendChatLine("assistant", err, true);
                transcript.pop();
                return;
            }
            const reply = data.reply || "";
            transcript.push({ role: "assistant", text: reply });
            appendChatLine("assistant", reply, false);
            renderListingCards(data.listings || []);
        } catch (e) {
            appendChatLine("assistant", "Could not reach the assistant. Check your connection and try again.", true);
            transcript.pop();
        } finally {
            sendButton.disabled = false;
            messageInput.disabled = false;
            messageInput.focus();
        }
    }

    sendButton.addEventListener("click", sendChatMessage);
    messageInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
            e.preventDefault();
            sendChatMessage();
        }
    });

    function toggleAccordion(id) {
        const content = document.getElementById(id);
        const icon = document.getElementById(id + "_icon");

        if (content.style.maxHeight) {
            content.style.maxHeight = null;
            if (icon) icon.style.transform = "rotate(0deg)";
        } else {
            content.style.maxHeight = content.scrollHeight + "px";
            if (icon) icon.style.transform = "rotate(180deg)";
        }
    }

    document.querySelector('[href="#bottomSection"]').addEventListener("click", () => {
        document.getElementById("bottomSection").scrollIntoView({ behavior: "smooth" });
        document.querySelectorAll('[id^="group_"]').forEach(content => {
            content.style.maxHeight = content.scrollHeight + "px";
            const icon = document.getElementById(content.id + "_icon");
            if (icon) icon.style.transform = "rotate(180deg)";
        });
    });
</script>
