@model UsedAndReliableCars.Models.CarSearchResultViewModel
@{
    ViewData["Title"] = "TrustRide - Search Results";
}

<!-- Hero Banner -->
<div class="car-Background relative flex w-full items-center justify-center overflow-hidden pt-25 pb-32">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-xs"></div>
    <div class="z-10 px-4 text-center">
        <h1 class="text-5xl font-extrabold text-white drop-shadow-lg">Search Results</h1>
        <p class="mt-4 text-lg text-gray-200">
            @if (Model.TotalFound > 0)
            {
                var start = (Model.CurrentPage - 1) * Model.PageSize + 1;
                var end = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalFound);
                <span>Showing @start–@end of @Model.TotalFound listing@(Model.TotalFound == 1 ? "" : "s")</span>
            }
            else if (Model.ErrorMessage == null)
            {
                <span>No listings found — try adjusting your search</span>
            }
        </p>
    </div>
    <div class="pointer-events-none absolute bottom-0 left-0 h-32 w-full bg-gradient-to-b from-transparent to-[#EAE0D5]"></div>
</div>

<section class="bg-[#EAE0D5] px-8 py-16">
    <div class="mx-auto max-w-6xl">

        <!-- Back link -->
        <a asp-controller="Home" asp-action="Index"
           class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-[#5E503F] hover:text-[#22333B]">
            ← Back to Search
        </a>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-10 py-10 text-center shadow-md">
                <div class="mb-3 text-4xl">⚠️</div>
                <p class="text-lg font-semibold text-red-700">@Model.ErrorMessage</p>
                <a asp-controller="Home" asp-action="Index"
                   class="mt-6 inline-block rounded-lg bg-[var(--tan)] px-8 py-3 font-semibold
                          text-[var(--jet)] shadow-md transition hover:bg-[var(--brown)] hover:text-[var(--bone)] hover:shadow-lg">
                    Try Again
                </a>
            </div>
        }
        else if (Model.Listings == null || Model.Listings.Count == 0)
        {
            <div class="mt-6 rounded-2xl border border-[#C6AC8F] bg-[#f5ede3] px-10 py-16 text-center shadow-md">
                <div class="mb-3 text-4xl">🔍</div>
                <p class="text-xl font-bold text-[#22333B]">No listings found</p>
                <p class="mt-2 text-[#5E503F]">Try a different car, a broader area, or search nationwide.</p>
                <a asp-controller="Home" asp-action="Index"
                   class="mt-6 inline-block rounded-lg bg-[var(--tan)] px-8 py-3 font-semibold
                          text-[var(--jet)] shadow-md transition hover:bg-[var(--brown)] hover:text-[var(--bone)] hover:shadow-lg">
                    Search Again
                </a>
            </div>
        }
        else
        {
            <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var listing in Model.Listings)
                {
                    var trend = listing.Vin != null && Model.PriceTrendByVin.TryGetValue(listing.Vin, out var t) ? t : null;

                    <div class="flex flex-col overflow-hidden rounded-2xl border border-[#C6AC8F] bg-[#EAE0D5] shadow-md transition hover:shadow-xl">

                        <!-- Photo: emoji fallback always underneath; img hides on error -->
                        <div class="relative h-48 w-full bg-[#C6AC8F]/30">
                            <div class="flex h-full w-full items-center justify-center text-5xl">🚗</div>
                            @if (listing.FirstPhoto != null)
                            {
                                <img src="@listing.FirstPhoto"
                                     alt=""
                                     class="absolute inset-0 h-full w-full object-cover"
                                     loading="lazy"
                                     onerror="this.style.display='none'" />
                            }
                        </div>

                        <div class="flex flex-1 flex-col p-6">

                            <!-- Title -->
                            <h2 class="text-lg font-bold leading-snug text-[#0A0908]">
                                @(listing.Heading ?? $"{listing.Year} {listing.Make} {listing.Model}")
                            </h2>

                            <!-- Price + trend badge -->
                            <div class="mt-2 flex items-center gap-3">
                                <span class="text-2xl font-extrabold text-[#22333B]">
                                    @(listing.Price.HasValue ? $"${listing.Price.Value:N0}" : "Price N/A")
                                </span>
                                @if (trend == "lower")
                                {
                                    <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700"
                                          title="Below historical average">
                                        ↓ Good Deal
                                    </span>
                                }
                                else if (trend == "higher")
                                {
                                    <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700"
                                          title="Above historical average">
                                        ↑ Above Avg
                                    </span>
                                }
                            </div>

                            <!-- Details -->
                            <ul class="mt-4 space-y-1 text-sm text-[#5E503F]">
                                @if (listing.Miles.HasValue)
                                {
                                    <li>🛣️ <span class="font-medium">@listing.Miles.Value.ToString("N0") mi</span></li>
                                }
                                @if (!string.IsNullOrEmpty(listing.Trim))
                                {
                                    <li>⚙️ @listing.Trim</li>
                                }
                                @if (!string.IsNullOrEmpty(listing.ExteriorColor))
                                {
                                    <li>🎨 @listing.ExteriorColor</li>
                                }
                                @if (!string.IsNullOrEmpty(listing.City) || !string.IsNullOrEmpty(listing.State))
                                {
                                    <li>📍 @listing.City@(!string.IsNullOrEmpty(listing.City) && !string.IsNullOrEmpty(listing.State) ? ", " : "")@listing.State</li>
                                }
                                @if (!string.IsNullOrEmpty(listing.SellerName))
                                {
                                    <li>🏪 @listing.SellerName</li>
                                }
                            </ul>

                            <!-- Action buttons -->
                            <div class="mt-auto flex flex-wrap gap-3 pt-6">
                                @if (!string.IsNullOrEmpty(listing.VdpUrl))
                                {
                                    <a href="@listing.VdpUrl" target="_blank" rel="noopener noreferrer"
                                       class="flex-1 rounded-lg bg-[var(--tan)] py-2 text-center text-sm
                                              font-semibold text-[var(--jet)] shadow-sm transition hover:bg-[var(--brown)] hover:text-[var(--bone)] hover:shadow-md">
                                        View Listing
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(listing.Vin))
                                {
                                    <a asp-controller="Home" asp-action="PriceHistory"
                                       asp-route-vin="@listing.Vin"
                                       asp-route-title="@(listing.Heading ?? $"{listing.Year} {listing.Make} {listing.Model}")"
                                       class="flex-1 rounded-lg border border-[#C6AC8F] py-2 text-center text-sm
                                              font-semibold text-[#5E503F] transition hover:bg-[#C6AC8F]/30">
                                        Price History
                                    </a>
                                }
                            </div>

                        </div>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                var startPage = Math.Max(1, Model.CurrentPage - 2);
                var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                <nav class="mt-12 flex flex-wrap items-center justify-center gap-2" aria-label="Search results pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-controller="Home" asp-action="FindCars"
                           asp-route-selectedCar="@Model.SelectedCar" asp-route-year="@Model.Year" asp-route-make="@Model.Make"
                           asp-route-zip="@Model.Zip" asp-route-city="@Model.City" asp-route-state="@Model.State" asp-route-nationwide="@Model.Nationwide"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           class="rounded-lg border border-[#C6AC8F] bg-[#EAE0D5] px-4 py-2 text-sm font-semibold text-[#5E503F] shadow-sm transition hover:bg-[#C6AC8F]/30">
                            ← Previous
                        </a>
                    }
                    @for (var p = startPage; p <= endPage; p++)
                    {
                        var isCurrent = p == Model.CurrentPage;
                        <a asp-controller="Home" asp-action="FindCars"
                           asp-route-selectedCar="@Model.SelectedCar" asp-route-year="@Model.Year" asp-route-make="@Model.Make"
                           asp-route-zip="@Model.Zip" asp-route-city="@Model.City" asp-route-state="@Model.State" asp-route-nationwide="@Model.Nationwide"
                           asp-route-page="@p"
                           class="@(isCurrent ? "bg-[var(--tan)] text-[var(--jet)]" : "border border-[#C6AC8F] bg-[#EAE0D5] text-[#5E503F] hover:bg-[#C6AC8F]/30") rounded-lg px-4 py-2 text-sm font-semibold shadow-sm transition">
                            @p
                        </a>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-controller="Home" asp-action="FindCars"
                           asp-route-selectedCar="@Model.SelectedCar" asp-route-year="@Model.Year" asp-route-make="@Model.Make"
                           asp-route-zip="@Model.Zip" asp-route-city="@Model.City" asp-route-state="@Model.State" asp-route-nationwide="@Model.Nationwide"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           class="rounded-lg border border-[#C6AC8F] bg-[#EAE0D5] px-4 py-2 text-sm font-semibold text-[#5E503F] shadow-sm transition hover:bg-[#C6AC8F]/30">
                            Next →
                        </a>
                    }
                </nav>
            }
        }

    </div>
</section>
