@*
    Views/Shared/_AiPanel.cshtml
    Rendered once in _Layout.cshtml just before </body>.
    Uses Tailwind for all styling except the three edge cases
    noted in ai-panel.css (compound transform, flex min-height, scrollbar).
*@


@* ── Pull-tab toggle button ────────────────────────────────  *@
<button id="ai-panel-tab"
        aria-label="Open AI Assistant"
        aria-expanded="false"
        aria-controls="ai-panel"
        class="fixed top-1/2 right-0 z-[200] flex -translate-y-1/2 flex-col items-center
               justify-center gap-1 h-24 w-[42px] cursor-pointer rounded-l-xl border
               border-r-0 border-[#C6AC8F40] bg-[#0A0908] p-0 text-[#C6AC8F]
               opacity-70 transition-all duration-300 hover:bg-[#141210]
               hover:text-[#EAE0D5] hover:opacity-100
               aria-expanded:opacity-0 aria-expanded:pointer-events-none">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path d="m12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.003-.011l.018-.43l-.003-.012l-.01-.01z"/>
        <path d="M9.107 5.448c.598-1.75 3.016-1.803 3.725-.159l.06.16l.807 2.36a4 4 0 0 0 2.276 2.411l.217.081l2.36.806c1.75.598 1.803 3.016.16 3.725l-.16.06l-2.36.807a4 4 0 0 0-2.412 2.276l-.081.216l-.806 2.361c-.598 1.75-3.016 1.803-3.724.16l-.062-.16l-.806-2.36a4 4 0 0 0-2.276-2.412l-.216-.081l-2.36-.806c-1.751-.598-1.804-3.016-.16-3.724l.16-.062l2.36-.806A4 4 0 0 0 8.22 8.025l.081-.216zM11 6.094l-.806 2.36a6 6 0 0 1-3.49 3.649l-.25.091l-2.36.806l2.36.806a6 6 0 0 1 3.649 3.49l.091.25l.806 2.36l.806-2.36a6 6 0 0 1 3.49-3.649l.25-.09l2.36-.807l-2.36-.806a6 6 0 0 1-3.649-3.49l-.09-.25zM19 2a1 1 0 0 1 .898.56l.048.117l.35 1.026l1.027.35a1 1 0 0 1 .118 1.845l-.118.048l-1.026.35l-.35 1.027a1 1 0 0 1-1.845.117l-.048-.117l-.35-1.026l-1.027-.35a1 1 0 0 1-.118-1.845l.118-.048l1.026-.35l.35-1.027A1 1 0 0 1 19 2"/>
    </svg>
    <span class="text-[0.58rem] font-bold uppercase tracking-widest">AI</span>
</button>


@* ── Slide-out panel ───────────────────────────────────────  *@
<aside id="ai-panel"
       aria-label="AI Assistant"
       aria-hidden="true"
       class="fixed inset-y-0 right-0 z-[200] flex w-[min(380px,92vw)] translate-x-full
              flex-col overflow-hidden border-l border-[#C6AC8F40]
              shadow-[-10px_0_40px_-4px_rgba(0,0,0,0.6)]
              transition-transform duration-300 ease-in-out">

    
@* Header  *@
    <div class="flex shrink-0 items-center justify-between bg-[#22333B] px-6 py-4">
        <div class="flex items-center gap-3">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--tan)]">
                <svg viewBox="0 0 24 24" height="16" width="16" fill="currentColor" class="text-[#22333B]" aria-hidden="true">
                    <path d="M9.107 5.448c.598-1.75 3.016-1.803 3.725-.159l.06.16l.807 2.36a4 4 0 0 0 2.276 2.411l.217.081l2.36.806c1.75.598 1.803 3.016.16 3.725l-.16.06l-2.36.807a4 4 0 0 0-2.412 2.276l-.081.216l-.806 2.361c-.598 1.75-3.016 1.803-3.724.16l-.062-.16l-.806-2.36a4 4 0 0 0-2.276-2.412l-.216-.081l-2.36-.806c-1.751-.598-1.804-3.016-.16-3.724l.16-.062l2.36-.806A4 4 0 0 0 8.22 8.025l.081-.216z" />
                </svg>
            </div>
            <div>
                <p class="font-bold text-[#EAE0D5]">AutoGems AI</p>
                <p class="text-xs text-[#C6AC8F]">Powered by real market data</p>
            </div>
        </div>
        <button id="ai-panel-close"
                aria-label="Close AI Assistant"
                class="rounded-full p-1 text-[#C6AC8F] transition hover:bg-white/10 hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
        </button>
    </div>

    
@* Message list  *@
    <div id="ai-panel-messages"
         class="flex flex-1 flex-col gap-4 overflow-y-auto bg-[#f5ede3] px-6 py-4 scroll-smooth"
         aria-live="polite"
         aria-atomic="false">
        <div class="flex items-start gap-3">
            <div class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#22333B]">
                <svg viewBox="0 0 24 24" height="14" width="14" fill="currentColor" class="text-[var(--tan)]" aria-hidden="true">
                    <path d="M9.107 5.448c.598-1.75 3.016-1.803 3.725-.159l.06.16l.807 2.36a4 4 0 0 0 2.276 2.411l.217.081l2.36.806c1.75.598 1.803 3.016.16 3.725l-.16.06l-2.36.807a4 4 0 0 0-2.412 2.276l-.081.216l-.806 2.361c-.598 1.75-3.016 1.803-3.724.16l-.062-.16l-.806-2.36a4 4 0 0 0-2.276-2.412l-.216-.081l-2.36-.806c-1.751-.598-1.804-3.016-.16-3.724l.16-.062l2.36-.806A4 4 0 0 0 8.22 8.025l.081-.216z" />
                </svg>
            </div>
            <div class="max-w-[80%] rounded-2xl rounded-tl-none bg-[#22333B] px-4 py-3 text-sm leading-relaxed text-[#EAE0D5] shadow-sm">
                Hi! I'm your AutoGems AI assistant. Ask me anything about used cars — pricing, reliability, what's in stock, and more!
            </div>
        </div>
    </div>

    
@* Input area  *@
    <div class="flex shrink-0 items-center gap-3 border-t border-[#C6AC8F] bg-[#EAE0D5] px-4 py-4">
        <input id="ai-panel-input"
               type="text"
               placeholder="Ask about a car, price range, mileage..."
               aria-label="Your message"
               class="flex-1 rounded-xl border border-[#C6AC8F] bg-[#f5ede3] px-4 py-3 text-sm
                      text-[#22333B] placeholder-[#C6AC8F] outline-none transition
                      focus:border-[#5E503F] focus:ring-2 focus:ring-[#5E503F]/30" />
        <button id="ai-panel-send"
                aria-label="Send message"
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl
                       bg-[#22333B] text-[var(--tan)] shadow transition
                       hover:bg-[#22333B]/80 disabled:cursor-not-allowed disabled:opacity-50">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13" />
                <polygon points="22 2 15 22 11 13 2 9 22 2" />
            </svg>
        </button>
    </div>

</aside>


@* Backdrop  *@
<div id="ai-backdrop"
     class="fixed inset-0 z-[199] bg-black/45 opacity-0 pointer-events-none transition-opacity duration-300">
</div>
