<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    @* ── ADDED: AI panel shell styles ── *@
    <link rel="stylesheet" href="~/css/ai-panel.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fjalla+One&family=Fugaz+One&family=Luckiest+Guy&display=swap" rel="stylesheet">
</head>
<body class="fjalla-one-regular m-0 p-0 flex min-h-screen flex-col">
    <nav data-text-bright data-bg="charcoal"
         class="group absolute fixed top-0 left-1/2 z-50 mx-0 mt-2 mb-12 h-16 w-[95vw]
            max-w-[1440px] min-w-[380px] -translate-x-1/2 rounded-full bg-[#0A0908]/70 p-4
            text-[#EAE0D5] shadow
            shadow-[0_10px_20px_-10px_black]
            ring-2
            ring-[#C6AC8F]/40 backdrop-blur-md md:flex">

        <div class="absolute top-1/2 right-8 -translate-y-1/2 cursor-pointer">Login</div>

        <input type="checkbox" id="navbar__control"
               class="absolute top-4 left-4 z-10 h-8 w-8 opacity-0 md:hidden" />

        <div class="absolute top-1/2 left-1/2 m-0
                flex w-fit -translate-1/2 transform items-center rounded-full
                md:left-0 md:left-4 md:mr-4 md:translate-x-0">
            <a asp-controller="Home" asp-action="Index">
                <span class="mr-4 ml-2 cursor-pointer font-bold text-[var(--tan)] text-[clamp(1.1rem,calc(2vw_+_0.1rem),2rem)]">
                    AutoGems.ai
                </span>
            </a>
        </div>

        <div data-info="OPEN MENU ICON" class="relative h-8 w-8 cursor-pointer group-has-checked:hidden md:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24">
                <g fill="#fff" stroke-width="0.5" stroke="#fff">
                    <path d="M8 6.983a1 1 0 1 0 0 2h8a1 1 0 1 0 0-2zM7 12a1 1 0 0 1 1-1h8a1 1 0 1 1 0 2H8a1 1 0 0 1-1-1m1 3.017a1 1 0 1 0 0 2h8a1 1 0 1 0 0-2z" />
                    <path fill-rule="evenodd" d="M22 12c0 5.523-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2s10 4.477 10 10m-2 0a8 8 0 1 1-16 0a8 8 0 0 1 16 0" clip-rule="evenodd" />
                </g>
            </svg>
        </div>

        <div data-info="CLOSE MENU ICON" class="relative hidden h-8 w-8 cursor-pointer group-has-checked:block md:!hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24">
                <path fill="none" stroke="currentColor" stroke-dasharray="12" stroke-dashoffset="12"
                      stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 12l7 7M12 12l-7 -7M12 12l-7 7M12 12l7 -7">
                    <animate fill="freeze" attributeName="stroke-dashoffset" dur="0.3s" values="12;0" />
                </path>
            </svg>
        </div>

        <ul data-info="MENU ITEMS"
            class="align-center my-0 w-fit items-center gap-x-4 rounded-[16px] border-[2px_solid_#C6AC8F44] bg-[#22333B]/80
               p-0 transition-all group-has-checked:my-8 group-has-checked:-translate-x-2 group-has-checked:px-16
               group-has-checked:py-2 **:text-[clamp(1rem,calc(2vw_+_0.1rem),1.3rem)] **:transition-all md:absolute
               md:top-1/2
               md:left-1/2
               md:flex
               md:-translate-1/2
               md:bg-transparent
               md:py-4
               lg:gap-x-8
               **:[line-height:4px]
               **:has-[a]:grid
               **:has-[a]:place-content-center
               **:has-[a]:rounded-full
               **:has-[a]:bg-transparent
               **:has-[a]:px-0
               **:has-[a]:py-0
               **:has-[a]:group-has-checked:h-[2rem]
               **:has-[a]:group-has-checked:px-4
               **:has-[a]:group-has-checked:py-2">

            <li>
                <a asp-controller="Home" asp-action="Index" onClick="closeMenu()"
                   class="h-0 cursor-pointer opacity-0 group-has-checked:opacity-100 md:opacity-100">
                    Home
                </a>
            </li>

            <li class="my-0 h-0 group-has-checked:my-4 group-has-checked:h-6 md:mx-2 md:h-2 md:group-has-checked:my-0">
                <a asp-controller="Home" asp-action="About" onClick="closeMenu()"
                   class="h-0 cursor-pointer opacity-0 group-has-checked:opacity-100 md:opacity-100">
                    About Us
                </a>
            </li>

            <li class="my-0 h-0 group-has-checked:my-4 group-has-checked:h-6 md:mx-2 md:h-2 md:group-has-checked:my-0">
                <a asp-controller="Home" asp-action="Contact" onClick="closeMenu()"
                   class="h-0 cursor-pointer opacity-0 group-has-checked:opacity-100 md:opacity-100">
                    Contact
                </a>
            </li>
        </ul>

    </nav>

    <script>
        function closeMenu() {
          document.getElementById("navbar__control").checked = false;
        }

        function closeMobileMenuOnResizeWindow() {
          window.addEventListener("resize", () => {
            if (window.innerWidth > 768) {
              document.getElementById("navbar__control").checked = false;
            }
          })
        }
        closeMobileMenuOnResizeWindow();
    </script>

    <main class="flex-grow">
        @RenderBody()
    </main>

    <footer class="mt-12 bg-[#0A0908] py-6 text-[#C6AC8F]">
        <div class="mx-auto max-w-6xl text-center">
            <p>&copy; @DateTime.Now.Year AutoGems.ai. All rights reserved.</p>
        </div>
    </footer>

    @* ── ADDED: AI panel (rendered once, available on every page) ── *@
    @await Html.PartialAsync("_AiPanel")
    <script src="~/js/ai-panel.js" asp-append-version="true"></script>
</body>
</html>
